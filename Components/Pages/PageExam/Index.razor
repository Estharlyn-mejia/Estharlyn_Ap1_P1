@page "/Index"
@inject Services1 Autorservices
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Autores</PageTitle>

<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="text-center">Consulta de autores</h5>
            <button class="btn btn-primary" 
                    @onclick="MostrarPantallaCrear">
                    Crear
            </button>
        </div>

        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label" for="filtro">Filtrar por</label>
                    <select id="filtro" class="form-select" @bind="filtro">
                        <option value="">
                            Todos los campos
                        </option>
                        <option value="IdAutor">
                            Id
                        </option>
                        <option value="Nombres">
                            Nombres
                        </option>
                        <option value="Nacionalidad">
                            Nacionalidad
                        </option>
                        <option value="FechaNacimiento">
                            Fecha de nacimiento
                        </option>
                        <option value="Sueldo">
                            Sueldo
                        </option>
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label" for="valorFiltro">Buscar</label>
                    <input id="valorFiltro" class="form-control" @bind="valorFiltro" @bind:event="oninput" placeholder="Escribe para buscar" />
                </div>
                <div class="col-auto">
                    <button type="button" class="btn btn-outline-primary" @onclick="Buscar">Buscar</button>
                    <button type="button" class="btn btn-outline-secondary ms-2" @onclick="Restablecer">Restablecer</button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered mt-3 text-center align-middle">
                    <thead>
                        <tr>
                            <th>Autor Id</th>
                            <th>Nombres</th>
                            <th>Nacionalidad</th>
                            <th>Fecha de nacimiento</th>
                            <th>Sueldo</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var autor in listaAutores)
                        {
                            <tr>
                                <td>@autor.IdAutor</td>
                                <td>@autor.Nombres</td>
                                <td>@autor.Nacionalidad</td>
                                <td>@autor.FechaNacimiento.ToString("yyyy-MM-dd")</td>
                                <td>@autor.Sueldo</td>
                                <td>
                                    <button type="button" class="btn btn-outline-warning" @onclick="() => MostrarPantallaEditar(autor.IdAutor)">Editar</button>
                                </td>
                            </tr>
                        }
                        @if (listaAutores.Count == 0)
                        {
                            <tr><td colspan="6">No hay autores para mostrar.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            <strong>Conteo: @listaAutores.Count</strong>
        </div>
    </div>
</div>

@code {
    private List<Modelo1> listaAutores { get; set; } = [];
    private string? filtro;
    private string? valorFiltro;

    protected override async Task OnInitializedAsync()
    {
        listaAutores = await Autorservices.ObtenerTodos();
    }

    private async Task Buscar()
    {
        var autores = await Autorservices.ObtenerTodos();
        if (string.IsNullOrWhiteSpace(valorFiltro))
        {
            listaAutores = autores;
            return;
        }

        var termino = valorFiltro.Trim();
        listaAutores = filtro switch
        {
            "IdAutor" => int.TryParse(termino, out var id)
                ? autores.Where(autor => autor.IdAutor == id).ToList()
                : [],
            "Nombres" => autores.Where(autor => autor.Nombres.Contains(termino, StringComparison.OrdinalIgnoreCase)).ToList(),
            "Nacionalidad" => autores.Where(autor => autor.Nacionalidad.Contains(termino, StringComparison.OrdinalIgnoreCase)).ToList(),
            "FechaNacimiento" => autores.Where(autor => autor.FechaNacimiento.ToString("yyyy-MM-dd").Contains(termino, StringComparison.OrdinalIgnoreCase)).ToList(),
            "Sueldo" => autores.Where(autor => autor.Sueldo.ToString().Contains(termino, StringComparison.OrdinalIgnoreCase)).ToList(),
            _ => autores.Where(autor =>
                autor.Nombres.Contains(termino, StringComparison.OrdinalIgnoreCase) ||
                autor.Nacionalidad.Contains(termino, StringComparison.OrdinalIgnoreCase) ||
                autor.IdAutor.ToString().Contains(termino, StringComparison.OrdinalIgnoreCase) ||
                autor.FechaNacimiento.ToString("yyyy-MM-dd").Contains(termino, StringComparison.OrdinalIgnoreCase) ||
                autor.Sueldo.ToString().Contains(termino, StringComparison.OrdinalIgnoreCase)).ToList()
        };
    }

    private async Task Restablecer()
    {
        listaAutores = await Autorservices.ObtenerTodos();
        filtro = string.Empty;
        valorFiltro = string.Empty;
    }

    private void MostrarPantallaCrear(){Navigation.NavigateTo("/Crear");}

    private void MostrarPantallaEditar(int idAutor) { Navigation.NavigateTo($"/Editar/{idAutor}");}
}